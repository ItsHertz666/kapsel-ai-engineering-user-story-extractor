# PostgreSQL Connection String (Bun runtime & Drizzle ORM)
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/kapsel_db

# OpenRouter API Key (sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-ISI-KEY-ANDA

# Model Configuration
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Model Temperature (0.0 - 2.0, default: 0)
OPENROUTER_TEMPERATURE=0

# Backend Server Port (default: 3000)
PORT=3000
